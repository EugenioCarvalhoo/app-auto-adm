{
  "name": "controle-financeiro-backend",
  "version": "1.0.0",
  "description": "Backend do sistema de controle financeiro para restaurante",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --watch . --ext ts,json --ignore dist --ignore test --exec tsx server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.js",
    "start:prod": "node database/migrate.js && node dist/server.js",
    "migrate": "node database/migrate.js",
    "create-admin": "node database/create_admin.js",
    "test": "node scripts/test.js",
    "test:watch": "node scripts/test.js --watch",
    "test:coverage": "node scripts/test.js --coverage",
    "test:jest": "jest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^18.19.130",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "~5.9"
  }
}
