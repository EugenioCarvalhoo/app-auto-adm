{
  "name": "controle-financeiro-backend",
  "version": "1.0.0",
  "description": "Backend do sistema de controle financeiro para restaurante",
  "main": "dist/main.js",
  "scripts": {
    "dev": "nodemon --watch src --ext ts,json --exec tsx src/main.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/main.js",
    "start:prod": "node database/migrate.js && node dist/main.js",
    "migrate": "node database/migrate.js",
    "create-admin": "node database/create_admin.js",
    "test": "node scripts/test.js",
    "test:changed": "node scripts/test.js --onlyChanged --passWithNoTests",
    "test:watch": "node scripts/test.js --watch",
    "test:coverage": "node scripts/test.js --coverage",
    "test:jest": "jest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@nestjs/common": "^10.4.22",
    "@nestjs/core": "^10.4.22",
    "@nestjs/platform-express": "^10.4.22",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.25",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "~5.9"
  },
  "engines": {
    "node": ">=20"
  }
}
