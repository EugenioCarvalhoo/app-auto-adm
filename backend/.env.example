# Copie para .env (nunca commite .env com segredos reais).
# Produção / homologação: use um arquivo .env por container no Easypanel.

PORT=5000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_NAME=controle_financeiro
DB_USER=postgres
DB_PASSWORD=postgres

JWT_SECRET=altere_para_uma_chave_longa_e_aleatoria

# Leitura de boleto/nota por imagem (Gemini). Sem a chave, POST /api/boletos/extrair responde 503.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
# Opcional: URL base da API (padrao = oficial abaixo). So https; http apenas para localhost/127.0.0.1 (mock local).
# Invalida: a leitura por IA responde 503 "nao configurada" (o app continua de pe).
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models
# Opcional: timeout de cada chamada ao Gemini em ms (inteiro positivo, padrao 20000).
# GEMINI_TIMEOUT_MS=20000

# Armazenamento das imagens dos boletos: servico S3-compativel (MinIO, Cloudflare R2, AWS S3).
# O bucket deve existir e ser PRIVADO (a API nao o cria); a imagem so sai via GET /api/boletos/:id/anexo.
# Sem a configuracao completa (endpoint, bucket, chaves), POST/GET /api/boletos/:id/anexo respondem 503
# "Armazenamento de imagens nao configurado"; o resto do app segue funcionando.
# Endpoint: https sempre; http so para localhost, 127.0.0.1 e hostnames internos (nome sem ponto, ex.: http://minio:9000,
# ou terminado em .internal/.local/.svc).
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=boletos
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# Opcional: regiao (padrao us-east-1; MinIO aceita qualquer valor).
# STORAGE_REGION=us-east-1
# Opcional: endereco por caminho (padrao true; necessario na maioria dos MinIO). Use false para virtual-host (ex.: AWS S3).
# STORAGE_FORCE_PATH_STYLE=true

# Dias de retencao dos boletos excluidos antes da limpeza definitiva (npm run limpar-boletos). Ausente/invalido: nada e apagado.
BOLETOS_RETENCAO_DIAS=90

# Opcional: limite de leituras por imagem por usuario por minuto (padrao 10).
# EXTRAIR_RATE_LIMIT_MAX=10
# Opcional: teto de leituras por IA por usuario por dia (dia = America/Sao_Paulo; inteiro positivo, padrao 30).
# Persistido no banco (tabela boletos_extracoes_uso, migration 019). Ao estourar: 429 "Limite diario de leituras por IA atingido".
# EXTRAIR_LIMITE_DIARIO=30
