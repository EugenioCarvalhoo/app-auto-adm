# Copie para .env (nunca commite .env com segredos reais).
# Produção / homologação: use um arquivo .env por container no Easypanel.

PORT=5000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_NAME=controle_financeiro
DB_USER=postgres
DB_PASSWORD=postgres

JWT_SECRET=altere_para_uma_chave_longa_e_aleatoria

# Leitura de boleto por IA (Gemini). Sem GEMINI_API_KEY, POST /api/boletos/extrair responde 503.
# Em produção, defina a chave como secret do serviço; nunca a commite.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_MS=60000
# Raciocínio: automático pelo modelo (3.x = nível LOW; 2.5 = orçamento 0). Sobrescreva com
# GEMINI_THINKING_LEVEL (LOW, MINIMAL...) ou GEMINI_THINKING_BUDGET (inteiro; -1 automático). NONE = não envia.
# GEMINI_THINKING_LEVEL=LOW
# Padrão por modelo: 3.8 Flash = LOW; Flash-Lite e 3.6 = MINIMAL (mais rápido); 2.5 = orçamento 0.
# Resolução da imagem (LOW, MEDIUM, HIGH): LOW é mais rápido, mas pode perder texto pequeno. Padrão: do modelo.
# GEMINI_MEDIA_RESOLUTION=
# Opcional: URL base da API REST (padrão https://generativelanguage.googleapis.com/v1beta).
# GEMINI_BASE_URL=
# Erros temporários (429/500/503/504): até 3 tentativas dentro do prazo total, com espera crescente e aleatória.
# Depois da 2ª falha usa o modelo de reserva (padrão gemini-3.5-flash-lite; NONE desliga a troca):
# GEMINI_MODEL_FALLBACK=gemini-3.5-flash-lite
# Leituras por IA por usuário e por dia (0 bloqueia).
EXTRAIR_LIMITE_DIARIO=30
# Tamanho máximo da imagem enviada, em MB (acima disso: 413).
IMAGEM_MAX_MB=5
